# Real-data handling arrives with the pilot runbook. The app refuses to start with REAL_DATA_MODE=true and PUBLIC_DEMO_MODE=true together (A35).
REAL_DATA_MODE=false

# --- Supabase (PostgreSQL, Auth, Storage). DATABASE_URL is the Postgres connection the server uses.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgres://localhost:5432/acqfile
TEST_DATABASE_URL=postgres://localhost:5432/acqfile_test

# --- OpenAI. All model names are configurable. LLM_PROVIDER=mock runs the deterministic fixture-backed provider.
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_EXTRACT_MODEL=gpt-5.6-luna
OPENAI_VERIFY_MODEL=gpt-5.6-terra

# --- Inngest. JOB_DRIVER=inline processes uploads synchronously in the request (local dev and tests only).
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
JOB_DRIVER=inline

PIPELINE_VERSION=acqfile-0

AUTO_ACCEPT_THRESHOLD=0.86
REVIEW_THRESHOLD=0.65


MAX_UPLOAD_MB=10
MAX_DOCUMENT_PAGES=50

LLM_MAX_RETRIES=3
RETRY_DELAYS_MS=2000,8000,30000

# Anonymous visitors can browse the public demo. Signed-in admins can mutate; reviewers require DEMO_MUTATIONS_ENABLED=true.
# Never publish production passwords. Use unique strong passwords when seeding production.
PUBLIC_DEMO_MODE=true
DEMO_MUTATIONS_ENABLED=false

DEMO_ADMIN_EMAIL=admin@example.com
DEMO_ADMIN_PASSWORD=
DEMO_REVIEWER_EMAIL=reviewer@example.com
DEMO_REVIEWER_PASSWORD=
DEMO_VIEWER_EMAIL=viewer@example.com
DEMO_VIEWER_PASSWORD=

# Inject a failure into every new run: "<step>" or "<step>:<attempts>", e.g. independent_verify:1
FAILURE_INJECTION_STEP=

# --- Drivers. Production: AUTH_DRIVER=database, STORAGE_DRIVER=blob. Local: local/local.
AUTH_DRIVER=local
AUTH_SECRET=change-me-to-a-long-random-string
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=.data/storage
SUPABASE_STORAGE_BUCKET=sources

# Private Vercel Blob token (server-only)
BLOB_READ_WRITE_TOKEN=

# Set a private key of at least 32 characters before deal intake.
# Local synthetic corpus only: true selects the public fixture key; leave PII_HMAC_KEY empty.
ACQFILE_SAMPLE_MODE=false
PII_HMAC_KEY=

# Optional eight-case selector. Only explicitly configured synthetic staff workspace.
# Find the existing workspace/user UUIDs in your sample database; do not use real-data identities.
DEMO_CASE_WORKSPACE_ID=
# CLI seed/reset actor: an existing admin/reviewer member of that workspace. Never exposed in the UI.
DEMO_CASE_ACTOR_ID=
