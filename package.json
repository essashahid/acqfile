{
  "name": "acqfile",
  "version": "0.1.0",
  "private": true,
  "description": "Internal business-acquisition file preparation workbench",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.30.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . && tsx scripts/check-customer-copy.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --config vitest.config.mts",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:e2e": "playwright test",
    "eval": "tsx scripts/run-evals.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed-demo.ts --users-only",
    "db:reset": "tsx scripts/reset.ts",
    "fixtures:generate": "tsx scripts/generate-deal-fixtures.ts",
    "inngest:dev": "npx inngest-cli@latest dev -u http://localhost:3000/api/inngest",
    "verify:rls": "tsx scripts/verify-rls.ts",
    "deploy:production": "tsx scripts/deploy-production.ts",
    "rules:check": "tsx scripts/check-rules.ts",
    "rules:export-review": "tsx scripts/export-rules-review.ts",
    "fixtures:check": "tsx scripts/check-deal-fixtures.ts",
    "eval:live": "tsx scripts/run-live-evals.ts",
    "demo:seed": "tsx scripts/seed-demo.ts",
    "demo:b-ready": "tsx scripts/demo-b-ready.ts",
    "demo:cases": "tsx scripts/demo-cases.ts",
    "demo:generate": "tsx scripts/generate-demo-cases.ts"
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.3.3",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.116.0",
    "@vercel/blob": "2.8.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.2",
    "inngest": "4.20.0",
    "lucide-react": "1.44.0",
    "mammoth": "1.12.2",
    "next": "16.3.4",
    "openai": "7.13.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.3.289",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.6.0",
    "xlsx": "file:vendor/xlsx-0.20.3.tgz",
    "yaml": "2.9.0",
    "zod": "4.5.4",
    "jszip": "3.10.2"
  },
  "devDependencies": {
    "@faker-js/faker": "10.6.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.2",
    "@types/pdfkit": "0.17.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "docx": "9.7.1",
    "dotenv": "17.4.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "pdfkit": "0.20.2",
    "prettier": "3.6.2",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  }
}
